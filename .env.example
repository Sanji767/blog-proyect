# Google Analytics (GA4)
# Use ONE of these (GA4 Measurement ID format: G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-DY4WC315BN
GOOGLE_ANALYTICS_ID=G-DY4WC315BN

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: recipient for newsletter/leads (defaults to CONTACT_TO_EMAIL)
LEAD_TO_EMAIL=
# Must be a verified sender in Resend (recommended: no-reply@yourdomain.com)
CONTACT_FROM_EMAIL=

# Newsletter (Resend Audiences) — used by /api/subscribe.
# Create the audience in Resend (dashboard → Audiences) and paste its ID here.
# Without it, subscriptions fall back to an email to LEAD_TO_EMAIL/CONTACT_TO_EMAIL
# and the subscriber must be added manually. The RESEND_API_KEY must be a
# full-access key: a sending-only key cannot create contacts.
RESEND_AUDIENCE_ID=

# Sanity (CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=lta3kp7s
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-01
NEXT_PUBLIC_SANITY_STUDIO_TITLE= FinazasEU
